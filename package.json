{
  "name": "photometrix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "husky",
    "start": "node scripts/dev.mjs",
    "start:app": "node scripts/dev.mjs app",
    "start:server": "node scripts/dev.mjs server",
    "db:start": "node scripts/database.mjs start",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node scripts/database.mjs migrate",
    "db:seed": "node scripts/database.mjs seed",
    "lint": "eslint scripts lint-staged.config.mjs && pnpm -r --if-present lint",
    "lint:fix": "eslint scripts lint-staged.config.mjs --fix && pnpm -r --if-present lint:fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test scripts/*.test.mjs && pnpm -r --if-present test",
    "test:e2e": "node scripts/database.mjs test",
    "build": "pnpm -r --if-present build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.9.10"
  }
}
