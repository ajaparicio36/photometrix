# pnpm start generates ignored .env and .local/credentials.json automatically.
POSTGRES_USER=photometrix
POSTGRES_PASSWORD=<generated-random-secret>
POSTGRES_DB=photometrix
POSTGRES_PORT=5433
DATABASE_URL=postgresql://photometrix:<generated-random-secret>@127.0.0.1:5433/photometrix
TEST_DATABASE_URL=postgresql://photometrix:<generated-random-secret>@127.0.0.1:5433/photometrix_test
JWT_SECRET=<generated-random-secret-at-least-32-characters>
JWT_EXPIRES_IN_SECONDS=3600
PORT=3000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082
RCT_METRO_PORT=8082
SEED_EMAIL=photometrix@cpu.edu.ph
SEED_PASSWORD=<generated-random-password-at-least-16-characters>
# Physical phone: replace localhost with the development PC's LAN address.
EXPO_PUBLIC_API_URL=http://localhost:3000/api
